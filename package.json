{
  "name": "cinebook",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/prepare-prisma.js && prisma generate --schema=prisma/schema.prisma",
    "build": "node scripts/prepare-prisma.js && prisma generate --schema=prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "node scripts/prepare-prisma.js && prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "node scripts/prepare-prisma.js && prisma db push --schema=prisma/schema.prisma",
    "prisma:seed": "node prisma/seed.js",
    "db:switch:postgres": "node scripts/switch-database.js postgres",
    "db:switch:sqlite": "node scripts/switch-database.js sqlite",
    "db:migrate:postgres": "node scripts/migrate-sqlite-to-postgres.js",
    "db:history": "node scripts/export-history.js",
    "db:show": "node scripts/show-history.js",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.454.0",
    "next": "^14.2.18",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
