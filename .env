# ==============================================================================
# CINEBOOK ENVIRONMENT CONFIGURATION
# ==============================================================================

# Centralized Database Configuration (PostgreSQL / SQLite)
# For local development with SQLite:
DATABASE_URL="file:./dev.db"

# For Centralized PostgreSQL Database (Local, Supabase, Neon, AWS RDS, Render):
# DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/cinebook?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="cinebook"
POSTGRES_URL="postgresql://postgres:your_postgres_password@localhost:5432/cinebook?schema=public"

# Authentication & Security Secrets
NEXTAUTH_SECRET="cinebook_secret_jwt_key_super_secure_2026"
JWT_SECRET="cinebook_jwt_token_secret_key_production_grade"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID="rzp_test_cinebook123"
RAZORPAY_KEY_SECRET="rzp_test_secret_key_456"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_cinebook123"
