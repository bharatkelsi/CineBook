# ==============================================================================
# CINEBOOK ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env for local development, or configure these keys in
# your cloud hosting provider (Vercel Project Settings -> Environment Variables).
# NEVER commit your actual .env file or secrets to Git.

# Database Connection URL
# - Local development (SQLite): "file:./dev.db"
# - Production (PostgreSQL / Neon / Supabase / Vercel Postgres):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require"

# Authentication & Security Secrets (generate strong random 32+ char strings in prod)
NEXTAUTH_SECRET="replace_with_secure_random_32_char_secret"
JWT_SECRET="replace_with_secure_random_jwt_secret"

# Public Application URL (e.g. https://your-cinebook-app.vercel.app in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Optional Integrations (Email Notifications & Movie Metadata)
RESEND_API_KEY=""
EMAIL_FROM="CINEBOOK <notifications@cinebook.com>"
TMDB_API_KEY=""
